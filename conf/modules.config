/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]

    withName: SAMPLESHEET_CHECK {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode, pattern: '*_versions.yml']
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
}

//
// Genome preparation options
//

process {
    withName: 'GUNZIP_.*|MAKE_TRANSCRIPTS_FASTA' {
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: 'UNTAR_.*' {
        ext.args2 = '--no-same-owner'
    }

    withName: 'UNTAR_.*|STAR_GENOMEGENERATE|STAR_GENOMEGENERATE_IGENOMES' {
        publishDir = [path: { "${params.outdir}/genome/index" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: GFFREAD {
        ext.args   = '--keep-exon-attrs -F -T'
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: GFFREAD_TX2GENE {
        ext.args   = "--table transcript_id,${params.gtf_group_features},${params.gtf_extra_attributes}"
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: SALMON_INDEX {
        ext.args   = params.gencode ? '--gencode' : ''
        publishDir = [path: { "${params.outdir}/genome/index" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: CAT_FASTQ {
        publishDir = [path: { "${params.outdir}/fastq" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_merged_fastq]
    }

    withName: CUSTOM_GETCHROMSIZES {
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: PREPROCESS_TRANSCRIPTS_FASTA_GENCODE {
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }

    withName: GTF_GENE_FILTER {
        publishDir = [path: { "${params.outdir}/genome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }, enabled: params.save_reference]
    }
}

//
// Read QC and trimming options
//

process {

    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:FASTQC' {
        ext.args = params.source == "fastq" && !params.skip_fastqc ? '--quiet' : null
    }

    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE' {
        ext.args   = params.source == "fastq" && !params.skip_trimming
            ? [params.skip_trimgalore_fastqc ? "" : '--fastqc', params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : ''].join(' ').trim()
            : null
        publishDir = params.source == "fastq" && !params.skip_trimming
            ? [[path: { "${params.outdir}/trimgalore/fastqc" }, mode: params.publish_dir_mode, pattern: "*.{html,zip}"], [path: { "${params.outdir}/trimgalore" }, mode: params.publish_dir_mode, pattern: "*.fq.gz", enabled: params.save_trimmed], [path: { "${params.outdir}/trimgalore" }, mode: params.publish_dir_mode, pattern: "*.txt"]]
            : []
    }
}



//
// General alignment options
//


//
// STAR Salmon alignment options
//

process {
    withName: 'STAR_ALIGN|STAR_ALIGN_IGENOMES' {
        ext.args   = !params.skip_alignment && params.aligner in ['star_salmon', 'star']
            ? ['--quantMode TranscriptomeSAM', '--twopassMode Basic', '--outSAMtype BAM Unsorted', '--readFilesCommand gunzip -c', '--runRNGseed 0', '--outFilterMultimapNmax 20', '--alignSJDBoverhangMin 1', '--outSAMattributes NH HI AS NM MD', '--quantTranscriptomeBan Singleend', params.save_unaligned ? '--outReadsUnmapped Fastx' : ''].join(' ').trim()
            : null
        publishDir = !params.skip_alignment && params.aligner in ['star_salmon', 'star']
            ? [[path: { "${params.outdir}/${params.aligner}/log" }, mode: params.publish_dir_mode, pattern: '*.{out,tab}'], [path: { "${params.outdir}/${params.aligner}" }, mode: params.publish_dir_mode, pattern: '*.bam', enabled: params.save_align_intermeds], [path: { "${params.outdir}/${params.aligner}/unmapped" }, mode: params.publish_dir_mode, pattern: '*.fastq.gz', enabled: params.save_unaligned]]
            : []
    }
}

//
// Samtools bam options
//

process {

    withName: '.*:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        publishDir = params.source != "salmon_results" && !params.skip_alignment
            ? [[path: { "${params.outdir}/${params.aligner}/samtools_stats" }, mode: params.publish_dir_mode, pattern: "*.{stats,flagstat,idxstats}"]]
            : []
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = {
            params.source != "salmon_results" && !params.skip_alignment
                ? "${meta.id}_sorted"
                : null
        }
        publishDir = params.source != "salmon_results" && !params.skip_alignment
            ? [[path: { "${params.outdir}/${params.aligner}" }, mode: params.publish_dir_mode, pattern: "*.bam", enabled: params.aligner in ['star_salmon', 'star']]]
            : []
    }

    withName: SAMTOOLS_INDEX {
        ext.args   = params.source != "salmon_results" && !params.skip_alignment
            ? (params.bam_csi_index ? '-c' : '')
            : null
        publishDir = params.source != "salmon_results" && !params.skip_alignment
            ? [[path: { "${params.outdir}/${params.aligner}" }, mode: params.publish_dir_mode, pattern: "*.{bai,csi}", enabled: params.aligner in ['star_salmon', 'star']]]
            : []
    }
}

//
// Star salmon quant options
//

process {

    withName: SALMON_QUANT_STAR {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && !params.skip_alignment && params.aligner == 'star_salmon'
            ? [[path: { "${params.outdir}/${params.aligner}/${params.pseudo_aligner}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}

//
// Salmon pseudo-alignment options
//

process {

    withName: SALMON_QUANT_SALMON {
        publishDir = params.source == "fastq" && params.pseudo_aligner == 'salmon'
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}

//
// rMATs options
//

process {

    withName: 'RMATS_PREP|RMATS_POST|RMATS_PREP_SINGLE|RMATS_POST_SINGLE' {
        publishDir = params.source in ["fastq", "genome_bam"] && params.rmats
            ? [[path: { "${params.outdir}/${params.aligner}/rmats" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: 'CREATE_BAMLIST|CREATE_BAMLIST_SINGLE' {
        publishDir = params.source in ["fastq", "genome_bam"] && params.rmats
            ? [[path: { "${params.outdir}/${params.aligner}/rmats/bamlist" }, mode: params.publish_dir_mode, pattern: "*.txt"]]
            : []
    }
}

//
// DEXSeq Exon options
//

process {

    withName: REGTOOLS_JUNCTIONSEXTRACT {
        ext.args   = params.source in ["fastq", "genome_bam"] && params.leafcutter
            ? '-a 8 -i 50 -I 500000'
            : null
        publishDir = params.source in ["fastq", "genome_bam"] && params.leafcutter
            ? [[path: { "${params.outdir}/${params.aligner}/leafcutter" }, mode: params.publish_dir_mode]]
            : []
    }

    withName: LEAFCUTTER_CLUSTER {
        ext.args   = params.source in ["fastq", "genome_bam"] && params.leafcutter
            ? '-l 500000 -m 10'
            : null
        publishDir = params.source in ["fastq", "genome_bam"] && params.leafcutter
            ? [[path: { "${params.outdir}/${params.aligner}/leafcutter" }, mode: params.publish_dir_mode]]
            : []
    }
}

//
// DEXSeq Exon options
//

process {

    withName: DEXSEQ_ANNOTATION {
        publishDir = params.source in ["fastq", "genome_bam"] && params.dexseq_exon
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_exon/annotation" }, mode: params.publish_dir_mode, pattern: "*.gff", enabled: params.save_dexseq_annotation]]
            : []
    }

    withName: DEXSEQ_COUNT {
        publishDir = params.source in ["fastq", "genome_bam"] && params.dexseq_exon
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_exon/counts" }, mode: params.publish_dir_mode, pattern: "*.clean.count.txt"]]
            : []
    }

    withName: DEXSEQ_EXON {
        publishDir = params.source in ["fastq", "genome_bam"] && params.dexseq_exon
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_exon/results" }, mode: params.publish_dir_mode, pattern: "*.{csv,pdf,rds}"]]
            : []
    }
}

//
// DEXSeq DTU options (aligner)
//

process {

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DRIMSEQ_FILTER' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_dtu/filter/drimseq" }, mode: params.publish_dir_mode, pattern: "*.rds"]]
            : []
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DEXSEQ_DTU' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/dexseq" }, mode: params.publish_dir_mode, pattern: "*.{tsv,rds}"]]
            : []
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:STAGER' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/stager" }, mode: params.publish_dir_mode, pattern: "*.{tsv,rds}"]]
            : []
    }
}

//
// DEXSeq DTU options (pseudo-aligner)
//

process {

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DRIMSEQ_FILTER' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/filter/drimseq" }, mode: params.publish_dir_mode, pattern: "*.rds"]]
            : []
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DEXSEQ_DTU' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/dexseq" }, mode: params.publish_dir_mode, pattern: "*.{tsv,rds}"]]
            : []
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:STAGER' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.dexseq_dtu
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/stager" }, mode: params.publish_dir_mode, pattern: "*.{tsv,rds}"]]
            : []
    }
}

//
// edgeR DEU config
//

process {

    withName: SUBREAD_FLATTENGTF {
        ext.args   = params.source in ["fastq", "genome_bam"] && params.edger_exon
            ? ["-t exon", "-g ${params.gtf_group_features}", '-C'].join(' ').trim()
            : null
        publishDir = params.source in ["fastq", "genome_bam"] && params.edger_exon
            ? [[path: { "${params.outdir}/${params.aligner}/featurecounts" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: SUBREAD_FEATURECOUNTS {
        ext.args   = params.source in ["fastq", "genome_bam"] && params.edger_exon
            ? ['-F SAF', "-t exon", "-g ${params.gtf_group_features}", '-f', '-O', '-B', '-C'].join(' ').trim()
            : null
        publishDir = params.source in ["fastq", "genome_bam"] && params.edger_exon
            ? [[path: { "${params.outdir}/${params.aligner}/featurecounts" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: EDGER_EXON {
        publishDir = params.source in ["fastq", "genome_bam"] && params.edger_exon
            ? [[path: { "${params.outdir}/${params.aligner}/edger" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}

//
// SUPPA options (aligner)
//

process {

    withName: '.*:SUPPA_STAR_SALMON:GENERATE_EVENTS_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_local_event" }, mode: params.publish_dir_mode, pattern: '*.{ioe,gtf}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_isoform" }, mode: params.publish_dir_mode, pattern: '*.ioi', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_STAR_SALMON:PSIPEREVENT' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/psi_per_local_event" }, mode: params.publish_dir_mode, pattern: '*.psi', enabled: params.suppa_per_local_event]]
            : []
    }

    withName: '.*:SUPPA_STAR_SALMON:PSIPERISOFORM' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/psi_per_isoform" }, mode: params.publish_dir_mode, pattern: '*.psi', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLIT_FILES_(TPM|IOE|IOI)' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_local_event" }, mode: params.publish_dir_mode, pattern: 'local*.{tpm,psi}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_isoform" }, mode: params.publish_dir_mode, pattern: 'transcript*.{tpm,psi}', enabled: params.suppa_per_isoform], [path: { "${params.outdir}/${params.aligner}/suppa/split_files/tpms" }, mode: params.publish_dir_mode, pattern: '*.tpm']]
            : []
    }

    withName: '.*:SUPPA_STAR_SALMON:DIFFSPLICE_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_local_event" }, mode: params.publish_dir_mode, pattern: '*local*.{dpsi,psivec}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_isoform" }, mode: params.publish_dir_mode, pattern: '*transcript*.{dpsi,psivec}', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_STAR_SALMON:CLUSTEREVENTS_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_local_event" }, mode: params.publish_dir_mode, pattern: '*local*.{clustvec,log}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_isoform" }, mode: params.publish_dir_mode, pattern: '*transcript*.{clustvec,log}', enabled: params.suppa_per_isoform]]
            : []
    }
}

//
// SUPPA options (pseudo_aligner)
//

process {

    withName: '.*:SUPPA_SALMON:GENERATE_EVENTS_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_local_event" }, mode: params.publish_dir_mode, pattern: '*.{ioe,gtf}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_isoform" }, mode: params.publish_dir_mode, pattern: '*.ioi', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_SALMON:PSIPEREVENT' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_local_event" }, mode: params.publish_dir_mode, pattern: '*.psi', enabled: params.suppa_per_local_event]]
            : []
    }

    withName: '.*:SUPPA_SALMON:PSIPERISOFORM' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_isoform" }, mode: params.publish_dir_mode, pattern: '*.psi', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_SALMON:SPLIT_FILES_(TPM|IOE|IOI)' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_local_event" }, mode: params.publish_dir_mode, pattern: 'local*.{tpm,psi}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_isoform" }, mode: params.publish_dir_mode, pattern: 'transcript*.{tpm,psi}', enabled: params.suppa_per_isoform], [path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/tpms" }, mode: params.publish_dir_mode, pattern: '*.tpm']]
            : []
    }

    withName: '.*:SUPPA_SALMON:DIFFSPLICE_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_local_event" }, mode: params.publish_dir_mode, pattern: '*local*.{dpsi,psivec}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_isoform" }, mode: params.publish_dir_mode, pattern: '*transcript*.{dpsi,psivec}', enabled: params.suppa_per_isoform]]
            : []
    }

    withName: '.*:SUPPA_SALMON:CLUSTEREVENTS_(IOE|IOI)' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon" && params.suppa
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_local_event" }, mode: params.publish_dir_mode, pattern: '*local*.{clustvec,log}', enabled: params.suppa_per_local_event], [path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_isoform" }, mode: params.publish_dir_mode, pattern: '*transcript*.{clustvec,log}', enabled: params.suppa_per_isoform]]
            : []
    }
}

//
// TX2GENE_TXIMPORT options (aligner)
//

process {

    withName: '.*:TX2GENE_TXIMPORT_STAR_SALMON:TXIMPORT' {
        publishDir = params.source in ["fastq", "transcriptome_bam"] && params.aligner == "star_salmon"
            ? [[path: { "${params.outdir}/${params.aligner}/tximport" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}

//
// TX2GENE_TXIMPORT options (pseudo_aligner)
//

process {

    withName: '.*:TX2GENE_TXIMPORT_SALMON:UNTAR' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon"
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/tximport" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: '.*:TX2GENE_TXIMPORT_SALMON:TXIMPORT' {
        publishDir = params.source in ["fastq", "salmon_results"] && params.pseudo_aligner == "salmon"
            ? [[path: { "${params.outdir}/${params.pseudo_aligner}/tximport" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}

//
// MISO_VISUALISATION options
//

process {

    withName: GTF_2_GFF3 {
        publishDir = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? [[path: { "${params.outdir}/misopy" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: MISO_INDEX {
        publishDir = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? [[path: { "${params.outdir}/misopy" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: MISO_RUN {
        publishDir = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? [[path: { "${params.outdir}/misopy" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: MISO_SETTINGS {
        ext.args   = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? ["--bam_prefix ./bam_files", "--miso_prefix ./miso_data"].join(' ').trim()
            : null
        publishDir = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? [[path: { "${params.outdir}/misopy" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }

    withName: MISO_SASHIMI {
        publishDir = params.source in ["fastq", "genome_bam"] && params.sashimi_plot
            ? [[path: { "${params.outdir}/misopy" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]]
            : []
    }
}
