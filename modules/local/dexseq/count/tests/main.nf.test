// nf-core modules test dexseq/count
nextflow_process {

    name "Test Process DEXSEQ_COUNT"
    script "../main.nf"
    process "DEXSEQ_COUNT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_"
    tag "dexseq"
    tag "dexseq/count"

    test("dexseq - bam") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', strandedness:'unstranded', single_end:true ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gff3', checkIfExists: true)
                ]
                input[1] = 10
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }


    test("dexseq - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', strandedness:'unstranded', single_end:true ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gff3', checkIfExists: true)
                ]
                input[1] = 10
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
